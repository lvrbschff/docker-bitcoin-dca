# The bot derives its budget from completed Bitvavo deposits in the current cycle.
QUOTE_CURRENCY=EUR
BASE_ASSET=BTC
# Desired amount of BASE_ASSET per purchase. 0 means Bitvavo's calculated minimum.
BUY_AMOUNT=0
DEPOSIT_DAY=1
TIMEZONE=Europe/Berlin

# true means orders are sent to Bitvavo. Keep false until you have inspected logs.
LIVE_TRADING=false
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Re-check market and budget this often. 60 seconds is the minimum.
CHECK_INTERVAL_SECONDS=300
# Keep enough for fees and rounding. The bot never allocates this part of budget.
FEE_BUFFER_PERCENT=1
# State must be mounted persistently, especially in Docker deployments.
STATE_FILE=/data/state.json
